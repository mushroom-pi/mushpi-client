{
  "name": "mushpi-client",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:ci": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "audit:prod": "yarn npm audit --environment production --recursive --no-deprecations",
    "audit:ci": "yarn npm audit --environment production --recursive --no-deprecations --severity high",
    "knip": "knip",
    "knip:ci": "knip --include files,dependencies,unlisted --exclude devDependencies --no-gitignore",
    "prepare": "husky",
    "gen:client": "openapi-generator-cli generate -i ${OPENAPI_SPEC:-./openapi.json} -g typescript-axios -o src/api/generated --skip-validate-spec --additional-properties=supportsES6=true,useSingleRequestParameter=true && npm run gen:dedup",
    "gen:client:remote": "OPENAPI_SPEC=http://localhost:3000/contract-json npm run gen:client",
    "gen:dedup": "node scripts/dedup-generated.mjs",
    "gen:schemas": "openapi-zod-client ${OPENAPI_SPEC:-./openapi.json} -o src/api/generated/schemas.ts -t scripts/zod-schemas.hbs -p .prettierrc --export-schemas && yarn gen:fix-array-types",
    "gen:fix-array-types": "node scripts/fix-array-types.mjs",
    "gen:schemas:remote": "OPENAPI_SPEC=http://localhost:3000/contract-json yarn gen:schemas",
    "gen:all:remote": "OPENAPI_SPEC=http://localhost:3000/contract-json yarn gen:client && yarn gen:schemas:remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/x-date-pickers": "^8.16.0",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "dayjs": "^1.11.19",
    "lodash": "^4.17.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@eslint/js": "^9.37.0",
    "@openapitools/openapi-generator-cli": "^2.24.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/axios": "^0.14.4",
    "@types/lodash": "^4",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@zodios/core": "^10.9.6",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.51.0",
    "lint-staged": "^16.2.3",
    "openapi-zod-client": "^1.18.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
